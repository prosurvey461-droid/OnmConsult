{
  "entities": {
    "SiteContent": {
      "title": "SiteContent",
      "description": "Global website content and configuration",
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Full site data payload"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last edit"
        }
      },
      "required": ["data"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Contact form submissions and leads",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "projectType": { "type": "string" },
        "date": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["email", "date"]
    }
  },
  "firestore": {
    "/site_content/{docId}": {
      "entity": "SiteContent",
      "description": "Global website data documents"
    },
    "/inquiries/{inquiryId}": {
      "entity": "Inquiry",
      "description": "Customer contact submissions"
    }
  }
}
